# Copy to backend/.env and fill in. Never commit .env.
#
# One integration token per installation. Create both at notion.so/my-integrations
# and connect both to the Book Club page. See docs/notion-setup.md.
NOTION_TOKEN=ntn_xxx

# Database IDs from the Notion URL: the 32-char segment before ?v=
NOTION_BOOKS_DB_ID=
NOTION_POSTS_DB_ID=

# Optional. Each database ID resolves to a data source ID, which costs a Notion
# round trip on every start. Supply both to skip the lookup — `verify_notion.py`
# prints them. Worth setting for a deployment that starts often; unnecessary
# locally, where the process is long-lived.
NOTION_BOOKS_DATA_SOURCE_ID=
NOTION_POSTS_DATA_SOURCE_ID=

# Who this installation belongs to. Must appear in MEMBERS.
# Required with AUTH_MODE=open (the default). Meaningless, and best left unset,
# on a shared deployment where identity comes from a signed-in browser instead.
MEMBER_NAME=

# The full roster, comma-separated.
# Both installations must list members in the SAME ORDER — reader colours are
# assigned by roster index, so a swapped order swaps the two members' colours.
MEMBERS=Name A,Name B

# ---------------------------------------------------------------------------
# Only for a deployment both members reach. Leave all three unset to run the
# app the way it has always run: on your own machine, with no login.
# `scripts/make_secrets.py` generates the last two. See docs/deployment.md.
# ---------------------------------------------------------------------------
# AUTH_MODE=passphrase
# SESSION_SECRET=
# SITE_PASSPHRASE_HASH=
